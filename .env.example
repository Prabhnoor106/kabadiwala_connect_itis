# ============================================================
# Kabadiwala Connect — environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---------- Database (required) ----------
# PostgreSQL connection string. Supabase: Settings → Database → Connection string.
# Local: postgresql://postgres:password@localhost:5432/kabadiwala_connect
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ---------- Auth (required) ----------
# Use a long random value in production, e.g. openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# bcrypt cost factor. 10 for development, 12 for production.
BCRYPT_ROUNDS=10

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# Comma-separated allowlist of frontend origins. Empty means '*' (dev only).
CORS_ORIGIN=http://localhost:5173

# ---------- Image storage ----------
# Leave CLOUD_STORAGE_PROVIDER empty to store uploads in ./uploads locally.
CLOUD_STORAGE_PROVIDER=

# ImageKit (set CLOUD_STORAGE_PROVIDER=imagekit)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# S3-compatible (set CLOUD_STORAGE_PROVIDER=s3)
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=

# ---------- AI/ML model service (optional) ----------
# There is no trained model in this project. Left disabled, valuation uses the
# documented rule (price x weight x condition) and anomaly detection uses a
# statistical check — both clearly labelled as such in API responses.
# Set to true only when a real model service is running at AI_SERVICE_BASE_URL.
AI_SERVICE_ENABLED=false
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=8000

# Retrain is triggered once this many unapplied feedback records accumulate.
ML_FEEDBACK_THRESHOLD=50

# ---------- SMS / OTP ----------
# 'console' prints the OTP to the server log and returns it in the API response
# when NODE_ENV is not production — that is how you log in during development.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

NOTIFICATION_ENABLED=false

# ---------- Cron schedules ----------
PRICE_TREND_CRON=0 */6 * * *
MODEL_RETRAIN_CRON=0 2 * * *
