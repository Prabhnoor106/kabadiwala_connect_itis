# ============================================================
# Kabadiwala Connect — frontend environment template
# Copy to .env for local overrides (usually not needed in dev).
# On Vercel, set these in Project → Settings → Environment Variables.
# ============================================================

# Absolute origin of the deployed API, INCLUDING the /api suffix.
# Example: https://kabadiwala-connect-api.onrender.com/api
#
# Leave this UNSET for local development — vite.config.js proxies /api and
# /uploads to http://localhost:3000, so the app talks to a same-origin path.
VITE_API_BASE_URL=
