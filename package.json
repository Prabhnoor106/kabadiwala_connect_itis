{
  "name": "kabadiwala-connect-backend",
  "version": "1.0.0",
  "description": "Backend API for Kabadiwala Connect — connecting informal e-waste collectors with authorized recyclers",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:setup": "node scripts/applySchema.js",
    "db:seed": "node prisma/seed.js",
    "db:verify": "node scripts/verifyDb.js",
    "db:studio": "npx prisma studio",
    "test": "node --test \"tests/*.test.js\"",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "e-waste",
    "kabadiwala",
    "recycling",
    "traceability"
  ],
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/server": "^1.5.3",
    "axios": "^1.7.0",
    "bcryptjs": "2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.0.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "8.13.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
